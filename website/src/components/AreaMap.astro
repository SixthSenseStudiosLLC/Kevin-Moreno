---
interface Props {
  query?: string;
  zoom?: number;
}
// TODO: once there is a studio address or Google Business Profile, put it in `query`.
const { query = 'Fair Lawn, NJ', zoom = 11 } = Astro.props;
const src = `https://maps.google.com/maps?q=${encodeURIComponent(query)}&z=${zoom}&output=embed`;
---

<div class="map">
  <iframe src={src} title="Service area map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

<style>
  .map { height: clamp(280px, 35vw, 420px); background: var(--bg-raised); border-top: 1px solid var(--line); }
  iframe { width: 100%; height: 100%; border: 0; display: block; filter: grayscale(1); }
</style>
