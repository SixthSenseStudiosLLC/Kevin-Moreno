---
// Drone clips as a portfolio grid that plays as you scroll; each card opens the Drone page.
import { DRONE_CLIPS } from '../data/drone';

interface Props {
  town?: string;
}
const { town } = Astro.props;
const clips = DRONE_CLIPS.filter((c) => c.shape === 'wide' && (town ? c.town === town : c.section === 'homes'));
---

{clips.length > 0 && (
  <div class="cards">
    {clips.map((c) => (
      <a href="/drone" class="clip-card">
        <video src={`/videos/${c.name}.mp4`} poster={`/videos/${c.name}.jpg`} muted loop playsinline autoplay preload="metadata" data-autoplay aria-label={`${c.title}, ${c.town}`}></video>
        <span class="cap">{c.title}<span> · {c.town}</span></span>
      </a>
    ))}
  </div>
)}

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-top: 20px; }
  .clip-card { text-decoration: none; display: block; }
  .clip-card video { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--line); display: block; transition: opacity 0.15s; }
  .clip-card:hover video { opacity: 0.85; }
  .cap { display: block; font-size: 0.9rem; margin-top: 8px; }
  .cap span { color: var(--text-muted); }
</style>
