---
import { NAV, SITE } from '../site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<div class="topbar">
  <div class="container topbar-inner">
    <span>{SITE.area}</span>
    <span class="hide-sm">{SITE.hours}</span>
    {SITE.phone
      ? <a href={`tel:${SITE.phone}`}>Call {SITE.phone}</a>
      : <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
  </div>
</div>

<header class="header">
  <div class="container bar">
    <a href="/" class="logo" aria-label={SITE.name}>SixthSenseStudios</a>

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="/start" class="btn btn-primary nav-cta">Start a Project</a>
    </nav>
  </div>
</header>

<!-- Sticky call/quote bar on phones -->
<div class="mobile-cta">
  {SITE.phone ? <a href={`tel:${SITE.phone}`}>Call now</a> : <a href={`mailto:${SITE.email}`}>Email</a>}
  <a href="/start" class="primary">Free quote</a>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .topbar {
    background: var(--text); color: var(--bg);
    font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .topbar-inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 36px; }
  .topbar a { text-decoration: none; font-weight: 600; }

  .mobile-cta { display: none; }

  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo {
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav { display: flex; align-items: center; gap: 28px; }
  .nav a:not(.btn) {
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { color: var(--text); }
  .nav-cta { padding: 0.6em 1.1em; }

  .menu-toggle { display: none; background: none; border: 0; padding: 10px; cursor: pointer; color: var(--text); }
  .burger, .burger::before, .burger::after {
    display: block; width: 22px; height: 2px; background: currentColor; position: relative; content: '';
  }
  .burger::before { position: absolute; top: -7px; }
  .burger::after { position: absolute; top: 7px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-width: 860px) {
    .menu-toggle { display: block; }
    .nav {
      display: none;
      position: absolute;
      top: 68px; left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .nav.open { display: flex; }
    .nav a:not(.btn) { padding: 12px 0; font-size: 1.1rem; width: 100%; }
    .nav-cta { margin-top: 12px; }
    .hide-sm { display: none; }
    .mobile-cta {
      display: grid; grid-template-columns: 1fr 1fr;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      border-top: 1px solid var(--line); background: var(--bg);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .mobile-cta a {
      text-align: center; padding: 16px; text-decoration: none;
      font-family: var(--font-label); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase;
    }
    .mobile-cta .primary { background: var(--text); color: var(--bg); }
    :global(body) { padding-bottom: 56px; }
  }
</style>
