---
import { NAV, SITE } from '../site';
import TownTicker from './TownTicker.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <span class="area">{SITE.area}</span>
    </div>
    {SITE.phone
      ? <a href={`tel:${SITE.phone}`} class="contact">☎ {SITE.phone}</a>
      : <a href={`mailto:${SITE.email}`} class="contact">✉ {SITE.email}</a>}
  </div>
</div>

<header class="header">
  <div class="container bar">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <span class="logo-name">Reliable Kev</span>
      <span class="logo-studio">Media</span>
    </a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li class:list={{ 'has-menu': item.children }}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}{item.children && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {item.children && (
              <ul class="dropdown">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
        <li><a href="/start" class="nav-cta" aria-current={isActive('/start') ? 'page' : undefined}>Start a Project</a></li>
      </ul>
      <div class="nav-lens" aria-hidden="true">
        <span class="lens-mount"></span>
        <span class="lens-ring"></span>
        <span class="lens-barrel"></span>
        <span class="lens-front"></span>
        <span class="lens-mm">24mm</span>
      </div>
    </nav>
  </div>
</header>

<TownTicker />

<!-- Sticky call/quote bar on phones -->
<div class="mobile-cta">
  {SITE.phone ? <a href={`tel:${SITE.phone}`}>Call now</a> : <a href={`mailto:${SITE.email}`}>Email</a>}
  <a href="/start" class="primary">Free quote</a>
</div>


<script>
  // Drives the zoom lens under the menu.
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const lens = nav?.querySelector<HTMLElement>('.nav-lens');
  if (nav && lens) {
    const tabs = [...nav.querySelectorAll<HTMLAnchorElement>(':scope > ul > li > a:not(.nav-cta)')];
    const mm = lens.querySelector<HTMLElement>('.lens-mm')!;
    const home = tabs.find((t) => t.getAttribute('aria-current') === 'page') ?? tabs[0];
    const aimAt = (tab: HTMLElement) => {
      const i = tabs.indexOf(tab as HTMLAnchorElement);
      const navBox = nav.getBoundingClientRect();
      const box = tab.getBoundingClientRect();
      lens.style.setProperty('--lens-w', `${Math.max(52, box.left + box.width / 2 - navBox.left)}px`);
      const focal = 24 + (i / Math.max(1, tabs.length - 1)) * (200 - 24);
      mm.textContent = `${i <= 0 ? 24 : Math.round(focal / 5) * 5}mm`;
    };
    tabs.forEach((t) => {
      t.addEventListener('mouseenter', () => aimAt(t));
      t.addEventListener('focus', () => aimAt(t));
    });
    nav.addEventListener('mouseleave', () => aimAt(home));
    nav.addEventListener('focusout', (e) => { if (!nav.contains(e.relatedTarget as Node)) aimAt(home); });
    addEventListener('resize', () => aimAt(home));
    document.fonts?.ready.then(() => aimAt(home));
    aimAt(home);
    requestAnimationFrame(() => lens.classList.add('is-ready'));
  }
</script>

<style>
  /* Top bar, header and town ticker share one black so the top of the page reads as one piece. */
  .topbar { background: var(--bg); color: var(--text-muted); font-size: 0.8rem; }
  .topbar .contact { color: var(--text); }
  .topbar-inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 38px; }
  .topbar-left { display: flex; align-items: center; gap: 20px; }
  .area { font-family: var(--font-label); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.72rem; }
  .contact { text-decoration: none; font-weight: 600; white-space: nowrap; }

  .header {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 84px; }
  .logo { text-decoration: none; display: grid; gap: 4px; }
  .logo-name { font-size: 1.15rem; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1; white-space: nowrap; }
  @media (max-width: 420px) { .logo-name { font-size: 1rem; letter-spacing: 0.1em; } }
  .logo-studio {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.6rem; letter-spacing: 0.26em; color: var(--text-muted);
  }
  .logo-studio::before, .logo-studio::after { content: ''; height: 2px; background: var(--text); flex: 1; min-width: 10px; }

  /* Zoom lens under the menu: the barrel reaches toward the tab you point at (or the page you're on).
     Tabs further along the menu zoom it out further, from 24mm at Home to 200mm at the last tab. */
  .nav { position: relative; }
  .nav-lens {
    --lens-w: 0px;
    position: absolute; left: 0; bottom: -20px; height: 16px; width: var(--lens-w);
    display: flex; align-items: center; pointer-events: none;
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1); opacity: 0;
  }
  .nav-lens.is-ready { opacity: 1; }
  .lens-mount { flex: none; width: 12px; height: 16px; border-radius: 2px; background: linear-gradient(#5b5955, #3a3936); }
  /* Fixed zoom ring (ridged) near the camera, then the thinner tube that slides out. */
  .lens-ring {
    flex: none; width: 26px; height: 14px; border-radius: 1px;
    background: repeating-linear-gradient(90deg, #2e2d2b 0 1.5px, #6b6863 1.5px 4px);
  }
  .lens-barrel {
    flex: 1; height: 9px; min-width: 0; border-radius: 1px;
    background: linear-gradient(#9a978f, #6a6762 55%, #4f4d49);
  }
  .lens-front {
    flex: none; width: 8px; height: 16px; border-radius: 2px;
    background: linear-gradient(90deg, #4a4845, #2c2b29); box-shadow: 2px 0 0 #6f8592;
  }
  .lens-mm {
    position: absolute; left: 100%; margin-left: 10px; top: 50%; transform: translateY(-50%);
    font-family: var(--font-label); font-size: 0.62rem; letter-spacing: 0.12em; color: var(--text-muted); white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) { .nav-lens { transition: none; } }

  .nav > ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 4px; }
  .nav li { position: relative; }
  .nav > ul > li > a {
    display: block; padding: 8px 11px; border-radius: 2px; text-decoration: none;
    font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .nav > ul > li > a:hover, .nav a[aria-current='page'] { background: var(--text); color: var(--bg); }
  .caret { margin-left: 4px; font-size: 0.7em; }
  .nav > ul > li > a.nav-cta { border: 1px solid var(--text); margin-left: 8px; white-space: nowrap; }
  @media (max-width: 1300px) { .nav > ul > li > a { padding: 8px 8px; letter-spacing: 0.06em; } .bar { gap: 16px; } }
  .nav > ul > li > a.nav-cta:hover, .nav > ul > li > a.nav-cta[aria-current='page'] { background: var(--text); color: var(--bg); }
  /* Phones already have the pinned Free quote button (same page), so skip the extra menu row. */
  @media (max-width: 860px) { .nav > ul > li:has(> .nav-cta) { display: none; } }

  .dropdown {
    list-style: none; margin: 0; padding: 6px 0; min-width: 240px;
    position: absolute; top: 100%; left: 0;
    background: var(--bg); border: 1px solid var(--line); box-shadow: 0 8px 24px rgb(0 0 0 / 0.4);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity 0.15s, transform 0.15s;
  }
  .has-menu:hover .dropdown, .has-menu:focus-within .dropdown { opacity: 1; visibility: visible; transform: none; }
  .dropdown a {
    display: block; padding: 10px 16px; text-decoration: none;
    font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .dropdown a:hover { background: var(--text); color: var(--bg); }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .mobile-cta { display: none; }

  /* Smaller screens: no burger. The menu moves under the logo and wraps, so every option stays visible. */
  @media (max-width: 1120px) {
    .bar { flex-wrap: wrap; row-gap: 0; min-height: 0; padding-top: 14px; }
    .nav { order: 2; width: 100%; margin-top: 10px; }
    .nav > ul { flex-wrap: wrap; gap: 2px; padding-bottom: 10px; }
    .nav > ul > li > a { padding: 8px 10px; font-size: 0.74rem; white-space: nowrap; }
    .caret, .dropdown, .nav-lens { display: none; }
    .area { display: none; }
  }

  @media (max-width: 860px) {
    .mobile-cta {
      display: grid; grid-template-columns: 1fr 1fr;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      border-top: 1px solid var(--line); background: var(--bg);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .mobile-cta a {
      text-align: center; padding: 16px; text-decoration: none;
      font-family: var(--font-label); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase;
    }
    .mobile-cta .primary { background: var(--text); color: var(--bg); }
    :global(body) { padding-bottom: 56px; }
  }
</style>
