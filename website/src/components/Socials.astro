---
import { SITE } from '../site';

interface Props {
  boxed?: boolean;
}
const { boxed = false } = Astro.props;

// Simple 24px glyphs, drawn with currentColor so they follow the theme.
const icons: Record<string, { label: string; path: string }> = {
  facebook: { label: 'Facebook', path: 'M14 8h3V4h-3c-2.8 0-4 1.7-4 4.2V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.2-.6.6-.6z' },
  instagram: {
    label: 'Instagram',
    path: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3zm0 2A2.5 2.5 0 0 0 5 7.5v9A2.5 2.5 0 0 0 7.5 19h9a2.5 2.5 0 0 0 2.5-2.5v-9A2.5 2.5 0 0 0 16.5 5h-9zM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm0 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm4.8-3.3a1 1 0 1 1 0 2 1 1 0 0 1 0-2z',
  },
  linkedin: { label: 'LinkedIn', path: 'M4 9h3.5v11H4V9zm1.8-5.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 9h3.3v1.5c.5-.9 1.7-1.8 3.4-1.8 3.6 0 4.3 2.3 4.3 5.4V20h-3.5v-5.3c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H10V9z' },
  youtube: { label: 'YouTube', path: 'M22 8.2c-.2-1.5-1-2.5-2.4-2.7C17.4 5.2 12 5.2 12 5.2s-5.4 0-7.6.3C3 5.7 2.2 6.7 2 8.2 1.8 9.7 1.8 12 1.8 12s0 2.3.2 3.8c.2 1.5 1 2.5 2.4 2.7 2.2.3 7.6.3 7.6.3s5.4 0 7.6-.3c1.4-.2 2.2-1.2 2.4-2.7.2-1.5.2-3.8.2-3.8s0-2.3-.2-3.8zM10 15V9l5.2 3L10 15z' },
  tiktok: { label: 'TikTok', path: 'M16.6 3c.4 2.2 1.7 3.6 4 3.8v3.3c-1.5.1-2.8-.3-4-1v6.4c0 3.9-2.9 6.3-6.2 5.9-3.4-.4-5.4-3.6-4.5-6.8.7-2.6 3.3-4.3 6.2-3.9v3.4c-1.5-.4-3 .4-3.3 1.8-.3 1.5.8 2.8 2.3 2.8 1.4 0 2.3-1 2.3-2.5V3h3.2z' },
};

const links = Object.entries(SITE.socials)
  .filter(([, url]) => url)
  .map(([key, url]) => ({ url, ...icons[key] }));
---

{links.length > 0 && (
  <ul class:list={['socials', { boxed }]}>
    {links.map((l) => (
      <li>
        <a href={l.url} aria-label={l.label} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={l.path} fill="currentColor" /></svg>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .socials { list-style: none; display: flex; flex-wrap: wrap; gap: 14px; margin: 0; padding: 0; }
  .socials a { display: grid; place-items: center; }
  .boxed { gap: 6px; }
  .boxed a { width: 34px; height: 34px; background: var(--text); color: var(--bg); border-radius: 3px; }
  .boxed a:hover { opacity: 0.8; }
</style>
