---
interface Props {
  eyebrow: string;
  title: string;
  note: string;
}
const { eyebrow, title, note } = Astro.props;
---

<section class="section">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{note}</p>
    <span class="placeholder">Coming in a later brick</span>
    <slot />
  </div>
</section>
