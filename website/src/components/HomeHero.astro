---
// Homepage opener: the headline over the featured drone clip (Fair Lawn roof).
const VIDEO = '/videos/fair-lawn-roof';
---

<section class="hero">
  <video class="bg" src={`${VIDEO}.mp4`} poster={`${VIDEO}.jpg`} muted loop playsinline autoplay preload="auto" data-autoplay aria-hidden="true"></video>
  <div class="container hero-inner">
    <p class="kicker">Sixth Sense Studios · North Jersey</p>
    <p class="headline">It's not remaining.<br />It's evolution.</p>
    <p class="sub">
      Video production built on one discipline: telling people's stories with honesty and care. Every project is
      planned, directed and edited to show the full picture of your business, the people behind it and the community
      it serves.
    </p>
    <div class="actions">
      <a href="/contact#quote" class="btn btn-primary">Start a project</a>
      <a href="/work" class="btn">See the work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; display: flex; align-items: flex-end;
    min-height: clamp(460px, 62vw, 680px); padding: clamp(48px, 8vw, 96px) 0;
    background: radial-gradient(ellipse at 70% 20%, #262626, #050505 65%) center / cover no-repeat;
  }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to right, rgb(0 0 0 / 0.85), rgb(0 0 0 / 0.35) 70%), linear-gradient(to top, rgb(0 0 0 / 0.6), transparent 50%);
  }
  .hero { overflow: hidden; }
  .hero-inner { position: relative; z-index: 2; }
  .kicker {
    font-family: var(--font-label); font-size: 0.8rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 18px; display: flex; align-items: center; gap: 12px;
  }
  .kicker::before { content: ''; width: 28px; height: 2px; background: var(--text); }
  .headline {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 5.6rem); line-height: 1; text-transform: uppercase; letter-spacing: 0.06em;
    font-weight: 500; margin: 0 0 24px;
  }
  .sub { max-width: 52ch; font-size: clamp(1rem, 1.6vw, 1.15rem); color: #d4d4d4; margin-bottom: 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

</style>
