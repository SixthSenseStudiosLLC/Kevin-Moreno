---
// A thin rule with the circled RK in the middle. Separates big sections and closes each page.
import BrandMark from './BrandMark.astro';
---

<div class="brand-divider" aria-hidden="true"><BrandMark size="26px" /></div>

<style>
  .brand-divider { display: flex; align-items: center; gap: 16px; margin: 56px 0; color: var(--text); opacity: 0.7; }
  .brand-divider::before, .brand-divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .brand-divider :global(.brand-mark) { vertical-align: middle; margin: 0; }
</style>
