---
import { SERVICES } from '../site';

// One slide per service. Add `image` to a slide (a path in /public) to use a photo
// or still from your reel as the background.
const slides: { title: string; text: string; href: string; image?: string }[] = SERVICES.map((s) => ({
  title: s.slide,
  text: s.short,
  href: `/services#${s.id}`,
}));
---

<section class="slider" aria-roledescription="carousel" aria-label="Services">
  {slides.map((s, i) => (
    <div
      class:list={['slide', { active: i === 0 }]}
      style={s.image ? `background-image: url(${s.image})` : undefined}
      aria-hidden={i === 0 ? undefined : 'true'}
    >
      <div class="panel">
        <h2>{s.title}</h2>
        <p>{s.text}</p>
        <div class="buttons">
          <a href={s.href} class="sbtn">Learn More</a>
          <a href="/contact#quote" class="sbtn">Contact Us</a>
        </div>
      </div>
    </div>
  ))}
  <div class="dots">
    {slides.map((_, i) => <button aria-label={`Slide ${i + 1}`} class:list={{ on: i === 0 }}></button>)}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.slider').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dots button')];
    let current = 0;
    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === current);
        if (i === current) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, i) => d.classList.toggle('on', i === current));
    };
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); restart(); }));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    const restart = () => {
      if (reduce) return;
      clearInterval(timer);
      timer = window.setInterval(() => show(current + 1), 6000);
    };
    restart();
  });
</script>

<style>
  .slider { position: relative; height: clamp(420px, 58vw, 640px); overflow: hidden; background: #0a0a0a; }
  .slide {
    position: absolute; inset: 0; display: grid; place-items: center; padding: 24px var(--gutter);
    background: radial-gradient(circle at 30% 30%, #2a2a2a, #050505 70%) center / cover no-repeat;
    opacity: 0; transition: opacity 0.8s ease; pointer-events: none;
  }
  .slide.active { opacity: 1; pointer-events: auto; }
  .panel {
    max-width: 560px; text-align: center; padding: clamp(20px, 3vw, 32px);
    background: rgb(255 255 255 / 0.92); color: #111; border-radius: 2px;
  }
  .panel h2 { font-size: clamp(1.3rem, 2.6vw, 1.9rem); text-transform: uppercase; font-weight: 600; letter-spacing: 0.02em; margin-bottom: 12px; }
  .panel p { font-size: 0.92rem; color: #444; margin-bottom: 18px; }
  .buttons { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; }
  .sbtn {
    background: #111; color: #fff; text-decoration: none; border-radius: 2px; padding: 8px 14px;
    font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .sbtn:hover { opacity: 0.8; }
  .dots { position: absolute; bottom: 18px; left: 0; right: 0; display: flex; justify-content: center; gap: 8px; }
  .dots button { width: 10px; height: 10px; border-radius: 50%; border: 0; padding: 0; background: rgb(255 255 255 / 0.4); cursor: pointer; }
  .dots button.on { background: #fff; }
</style>
