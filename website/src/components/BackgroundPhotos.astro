---
// A dimmed drone loop behind the gray page gradient on every page (public/videos/bg-drone.mp4:
// the homes montage, then the Jersey City skyline and waterfront). Its poster still shows while it
// loads, and on its own when the visitor has reduced motion turned on.
const VIDEO = '/videos/bg-drone';
---

<div class="bg-photos" aria-hidden="true">
  <video class="bg-video" src={`${VIDEO}.mp4`} poster={`${VIDEO}.jpg`} muted loop playsinline autoplay preload="auto"></video>
</div>

<script>
  const v = document.querySelector<HTMLVideoElement>('.bg-video');
  if (v) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
      v.pause();
    } else {
      v.muted = true;
      const play = () => v.play().catch(() => {});
      play();
      // Phones in low-power mode block autoplay until the first touch.
      for (const type of ['touchstart', 'pointerdown', 'keydown', 'wheel']) addEventListener(type, play, { once: true, passive: true });
      // Pause while the tab is hidden, to save battery.
      document.addEventListener('visibilitychange', () => (document.hidden ? v.pause() : play()));
    }
  }
</script>

<style>
  .bg-photos { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  .bg-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(0.35); opacity: 0.22;
  }
</style>
