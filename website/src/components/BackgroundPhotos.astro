---
// Dimmed photos behind the gray page gradient. One shows at a time; scrolling further down the
// page dissolves to the next, so each part of the page has its own backdrop.
import { BG_PHOTOS } from '../data/photos';
---

<div class="bg-photos" aria-hidden="true">
  {BG_PHOTOS.map((p, i) => (
    <div class:list={['bg-photo', { on: i === 0 }]} style={`background-image: url(${p.src}); background-position: ${p.focus}`}></div>
  ))}
</div>

<script>
  const layers = [...document.querySelectorAll<HTMLElement>('.bg-photo')];
  if (layers.length > 1) {
    let current = 0;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const progress = max > 0 ? scrollY / max : 0;
      const next = Math.min(layers.length - 1, Math.floor(progress * layers.length));
      if (next === current) return;
      layers[current].classList.remove('on');
      layers[next].classList.add('on');
      current = next;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .bg-photos { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  .bg-photo {
    position: absolute; inset: 0; background-size: cover; background-repeat: no-repeat;
    filter: grayscale(0.35); opacity: 0; transition: opacity 1.6s ease;
  }
  .bg-photo.on { opacity: 0.22; }
  @media (prefers-reduced-motion: reduce) { .bg-photo { transition: none; } }
</style>
