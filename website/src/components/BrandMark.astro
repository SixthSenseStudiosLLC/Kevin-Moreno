---
// The circled RK mark, used like a small ® after big titles, in the footer and as the site icon.
// STAND-IN: drawn as "RK" letters until Kev's real RK monogram file is added; then replace the
// <text> with the monogram (keep the circle). `size` is relative to the text it follows.
interface Props {
  size?: string;
  class?: string;
}
const { size = '0.32em', class: cls } = Astro.props;
---

<svg class:list={['brand-mark', cls]} viewBox="0 0 40 40" style={`width:${size};height:${size}`} aria-hidden="true">
  <circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="2" />
  <text x="20" y="25.6" text-anchor="middle" fill="currentColor" font-family="Montserrat, sans-serif" font-size="15" font-weight="500" letter-spacing="0.5">RK</text>
</svg>

<style>
  .brand-mark { display: inline-block; vertical-align: super; margin-left: 0.12em; flex: none; }
</style>
