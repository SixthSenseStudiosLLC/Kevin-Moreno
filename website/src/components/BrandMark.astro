---
// The circled RK monogram, used like a small ® after big titles, beside the logo, in dividers and the footer.
// The monogram (public/images/rk-monogram.png, white on transparent) is used as a mask, so the mark
// takes the color of the text around it. `size` is relative to that text.
interface Props {
  size?: string;
  class?: string;
}
const { size = '0.32em', class: cls } = Astro.props;
const id = `rk-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['brand-mark', cls]} viewBox="0 0 40 40" style={`width:${size};height:${size}`} aria-hidden="true">
  <mask id={id} style="mask-type: alpha"><image href="/images/rk-monogram.png" x="7.5" y="7.5" width="25" height="25" /></mask>
  <circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="2" />
  <rect x="7.5" y="7.5" width="25" height="25" fill="currentColor" mask={`url(#${id})`} />
</svg>

<style>
  .brand-mark { display: inline-block; vertical-align: super; margin-left: 0.12em; flex: none; }
</style>
