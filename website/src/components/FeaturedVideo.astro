---
// A finished client piece with sound: poster first, plays only when the visitor presses play.
import type { FeaturedVideo } from '../data/featured';

interface Props { item: FeaturedVideo; heading?: 'h2' | 'h3' }
const { item, heading = 'h2' } = Astro.props;
const H = heading;
---

<figure class="featured">
  <div class="frame">
    <video
      src={`/videos/${item.video}.mp4`}
      poster={`/videos/${item.video}.jpg`}
      controls
      playsinline
      preload="none"
      aria-label={`${item.client}: ${item.kind}`}
    ></video>
  </div>
  <figcaption>
    <p class="kicker">{item.kind}</p>
    <H class="title">{item.client}</H>
    <p class="person">{item.person}</p>
    <p class="summary">{item.summary}</p>
  </figcaption>
</figure>

<style>
  .featured { margin: 24px 0 0; }
  .frame { aspect-ratio: 16 / 9; background: #0a0a0a; border: 1px solid var(--line); overflow: hidden; }
  .frame video { width: 100%; height: 100%; display: block; object-fit: cover; background: #000; }
  figcaption { margin-top: 16px; }
  .kicker {
    font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-muted) !important; margin: 0 0 4px;
  }
  .title { margin: 0 !important; font-size: 1.25rem; text-transform: uppercase; font-weight: 600; }
  .person { margin: 2px 0 10px; color: var(--text-muted) !important; font-size: 0.92rem; }
  .summary { margin: 0; color: #d4d4d4; }
</style>
