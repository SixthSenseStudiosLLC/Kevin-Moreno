---
import BrandMark from '../components/BrandMark.astro';
// Business card QR landing page: the studio's formal project intake. No site menu.
// Leads arrive with the subject "Project intake (business card)". Kept out of Google and the sitemap.
import Base from '../layouts/Base.astro';
import IntakeForm from '../components/IntakeForm.astro';
import { SITE } from '../site';

---

<Base title="Project Intake" description="Start a project with Reliable Kev Media." bare noindex>
  <div class="intake-page">
    <a href="/" class="lockup" aria-label={`${SITE.name} home`}>
      <BrandMark size="44px" class="lockup-mark" />
      <span class="name">Reliable Kev</span>
      <span class="sub">Media</span>
    </a>

    <header class="head">
      <p class="kicker">Project intake</p>
      <h1>Tell us about your project<BrandMark /></h1>
      <p class="intro">
        This takes about 2 minutes. Once we receive your intake form, our creative director will reach out to book a call
        and review your project needs.
      </p>
    </header>

    <IntakeForm subject="Project intake (business card)" page="Business card QR intake" />

    <footer class="foot">
      <nav aria-label="Explore the studio">
        <a href="/work">Work</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
      </nav>
      <p>
        <a href={`tel:${SITE.phone}`}>{SITE.phone}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .intake-page { max-width: 640px; margin: 0 auto; padding: 36px 16px 56px; }
  .lockup { display: grid; gap: 6px; width: fit-content; margin: 0 auto 40px; text-decoration: none; text-align: center; }
  .name { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .sub { display: flex; align-items: center; gap: 10px; font-size: 0.7rem; letter-spacing: 0.26em; color: var(--text-muted); }
  .sub::before, .sub::after { content: ''; height: 2px; flex: 1; min-width: 24px; background: var(--text); }

  .head { margin-bottom: 28px; }
  .kicker { font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 10px; }
  h1 { font-size: clamp(1.7rem, 6vw, 2.4rem); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 500; margin: 0 0 14px; }
  .intro { color: #d9d2c4; margin: 0; max-width: 54ch; }

  .foot { text-align: center; margin-top: 28px; color: var(--text-muted); font-size: 0.9rem; }
  .foot nav { display: flex; justify-content: center; gap: 22px; margin-bottom: 12px; }
  .foot nav a { font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text); }
  .foot p a { text-decoration: none; }

  .lockup { justify-items: center; }
  .lockup :global(.lockup-mark) { vertical-align: middle; margin: 0 0 6px; color: var(--text); }
</style>
