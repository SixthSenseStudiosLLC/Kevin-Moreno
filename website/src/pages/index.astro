---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import QuoteForm from '../components/QuoteForm.astro';
import AreaMap from '../components/AreaMap.astro';
import { SERVICES, SITE } from '../site';

// Layout follows gardenstatehomeexteriors.com: hero slider → intro → why choose →
// a section per service with a checklist → service grid → platforms strip → map → footer.

const counties = (await getCollection('counties')).sort((a, b) => a.data.order - b.data.order);
const towns = (await getCollection('towns')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const why = [
  {
    title: 'Every kind of video, one person',
    text: 'Monthly content, podcasts, events and brand films. You work with me from the first call to the final cut, so nothing gets lost in a hand-off.',
  },
  {
    title: 'Local trust and full context',
    text: 'I film the business, the owner and the town around them. Neighbors choose local, and they want to see who they are hiring before they call.',
  },
  {
    title: 'Built around your week',
    text: 'Shoot days are planned and batched, so filming never takes over your business. You get a steady stream of content without the hassle.',
  },
];

const reasons = [
  'Based in North Jersey, filming in your town',
  'One person from first call to final cut',
  'Free planning call before anything is filmed',
];

// Simple line icons for the service grid, keyed by service id.
const icons: Record<string, string> = {
  'monthly-content': 'M7 3v3M17 3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm3 7h3v3H8z',
  podcast: 'M12 3a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3zM5 11a7 7 0 0 0 14 0M12 18v3M8 21h8',
  events: 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z',
  projects: 'M3 6h14v12H3zM17 10l4-2.5v9L17 14',
};

const platforms = ['Instagram', 'TikTok', 'YouTube', 'Facebook', 'LinkedIn', 'Your Website'];
---

<Base>
  <HeroSlider />

  <div class="container home">
    <div class="content">
      <section>
        <h1>Sixth Sense Studios: North Jersey's video partner for content, events and podcasts</h1>
        <p>
          Welcome to Sixth Sense Studios, home of Reliable Kev and your local video partner in New Jersey. I specialize in
          {SERVICES.map((s, i) => <>{i === SERVICES.length - 1 ? ' and ' : i ? ', ' : ' '}<a href={`/services#${s.id}`}>{s.title.toLowerCase()}</a></>)}{' '}
          for towns, downtowns, local businesses and trade companies throughout
          {counties.map((c, i) => <>{i ? ' and ' : ' '}<a href={`/where-i-work/${c.id}`}>{c.data.name}</a></>)}.
        </p>
        <p>
          Trust is the most valuable thing a business has. People want to see who they are hiring before they call. I
          tell the full story: the work, the people behind it, and the town it belongs to, so your customers feel like
          they already know you.
        </p>
      </section>

      <section>
        <h2>Why choose Sixth Sense Studios for your video?</h2>
        {why.map((w) => (
          <>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </>
        ))}
        <ul class="checks">
          {reasons.map((r) => <li>{r}</li>)}
        </ul>

        <a href="/about" class="meet">
          <div class="meet-photo"><img src="/images/kev.jpg" alt="Kev, the filmmaker behind Sixth Sense Studios" loading="lazy" /></div>
          <div>
            <h3>Meet Reliable Kev</h3>
            <p>
              The person behind the camera. When you book a call, you are talking to the same person who plans, films and
              edits your project from start to finish. <span class="more">Continue reading</span>
            </p>
          </div>
        </a>
      </section>

      {SERVICES.map((s) => (
        <section id={s.id}>
          <h2>{s.title}</h2>
          <p>{s.short}</p>
          <p class="label">What's included:</p>
          <ul class="checks">
            {s.points.map((p) => <li>{p}</li>)}
            <li><a href={`/services#${s.id}`}>{s.title} service page</a></li>
          </ul>
        </section>
      ))}

      <section>
        <h2>Serving North Jersey</h2>
        <p>
          Every piece of work is tied to the town it was made in. I currently work in
          {towns.map((t, i) => <>{i === towns.length - 1 ? ' and ' : i ? ', ' : ' '}<a href={`/where-i-work/${t.data.county.id}/${t.id}`}>{t.data.name}</a></>)},
          with more towns coming. Nearby? <a href="/contact#quote">Reach out anyway.</a>
        </p>
      </section>
    </div>

    <aside class="side">
      <QuoteForm />
    </aside>
  </div>

  <section class="services-band">
    <div class="container">
      <h2 class="band-title">Our Services</h2>
      <div class="service-grid">
        {SERVICES.map((s) => (
          <div class="service">
            <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true">
              <path d={icons[s.id]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
            </svg>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <a href={`/services#${s.id}`} class="sbtn">Learn More</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="platforms" aria-label="Where your videos go">
    <div class="container">
      <p class="eyebrow">Made for</p>
      <ul>
        {platforms.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <AreaMap />
</Base>

<style>
  .home {
    display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(32px, 5vw, 64px); align-items: start;
    padding-top: clamp(48px, 6vw, 80px); padding-bottom: clamp(56px, 8vw, 96px);
  }
  .side { position: sticky; top: 108px; }

  .content section + section { margin-top: 48px; scroll-margin-top: 110px; }
  .content section { scroll-margin-top: 110px; }
  .content h1 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); text-transform: uppercase; font-weight: 600; letter-spacing: 0.02em; }
  .content h2 { font-size: clamp(1.35rem, 2.6vw, 1.8rem); text-transform: uppercase; font-weight: 600; }
  .content h3 { text-transform: uppercase; font-weight: 600; margin: 1.4em 0 0.4em; }
  .content p { color: #d4d4d4; }
  .content p a, .checks a { text-decoration: underline; }
  .label { font-weight: 600; color: var(--text) !important; margin-bottom: 0.4em; }

  .meet {
    display: grid; grid-template-columns: 140px 1fr; gap: 20px; align-items: start;
    margin-top: 32px; padding: 20px; max-width: 560px;
    border: 1px solid var(--line); background: var(--bg-raised); text-decoration: none;
  }
  .meet h3 { margin-top: 0; text-transform: none; }
  .meet p { font-size: 0.9rem; margin: 0; }
  .meet-photo { aspect-ratio: 4 / 3; background: #1a1a1a; display: grid; place-items: center; overflow: hidden; }
  .meet-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .more { text-decoration: underline; }

  .services-band { background: var(--bg-raised); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(56px, 8vw, 96px) 0; }
  .band-title { text-align: center; text-transform: uppercase; font-weight: 600; margin-bottom: 48px; }
  .service-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 40px 32px; }
  .service { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .service svg { margin-bottom: 14px; }
  .service h3 { text-transform: uppercase; font-weight: 600; }
  .service p { color: var(--text-muted); font-size: 0.92rem; flex: 1; }
  .sbtn {
    background: var(--text); color: var(--bg); text-decoration: none; border-radius: 2px; padding: 9px 16px;
    font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .sbtn:hover { opacity: 0.8; }

  .platforms { padding: 40px 0; text-align: center; }
  .platforms ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 16px 48px; }
  .platforms li { font-size: 1.15rem; font-weight: 600; letter-spacing: 0.06em; color: var(--text-muted); }

  @media (max-width: 900px) {
    .home { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 520px) {
    .meet { grid-template-columns: 1fr; }
  }
</style>
