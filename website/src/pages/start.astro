---
import Page from '../layouts/Page.astro';
import { SITE } from '../site';
---

<Page title="Start a Project" description="Tell me about your business and what you want to make.">
  <h1>Start a project</h1>
  <p>
    Tell me about your business, your town and what you want people to know. I'll get back to you within one business
    day with a simple plan and a straight number.
  </p>
  <p>
    Prefer email? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{SITE.phone && <> or call <a href={`tel:${SITE.phone}`}>{SITE.phone}</a></>}.
  </p>
  <p>Fill out the quote form and it comes straight to me.</p>
</Page>
