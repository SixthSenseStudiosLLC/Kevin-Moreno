---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const counties = await getCollection('counties');
  return counties.map((county) => ({ params: { county: county.id }, props: { county } }));
}

const { county } = Astro.props;
const towns = (await getCollection('towns', (t) => t.data.county.id === county.id)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<Base title={`Video production in ${county.data.name}, NJ`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow"><a href="/where-i-work">Where I work</a></p>
      <h1>{county.data.name}</h1>
      {county.data.blurb ? <p class="lede">{county.data.blurb}</p> : <p><span class="placeholder">County intro coming soon</span></p>}
      {towns.length ? (
        <ul class="towns">
          {towns.map((t) => <li><a href={`/where-i-work/${county.id}/${t.id}`}>{t.data.name}</a></li>)}
        </ul>
      ) : (
        <span class="placeholder">Towns coming soon</span>
      )}
    </div>
  </section>
</Base>

<style>
  .eyebrow a { text-decoration: none; }
  .towns { list-style: none; padding: 0; margin: 40px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .towns a {
    display: block; text-decoration: none; border: 1px solid var(--line);
    padding: 12px 20px; font-size: 1.05rem; letter-spacing: 0.04em;
  }
  .towns a:hover { border-color: var(--text); }
</style>
