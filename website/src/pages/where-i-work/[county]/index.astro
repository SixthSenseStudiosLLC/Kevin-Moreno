---
import BrandMark from '../../../components/BrandMark.astro';
import { getCollection } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { SERVICES } from '../../../site';

export async function getStaticPaths() {
  const counties = await getCollection('counties');
  return counties.map((county) => ({ params: { county: county.id }, props: { county } }));
}

const { county } = Astro.props;
const name = county.data.name;
const towns = (await getCollection('towns', (t) => t.data.county.id === county.id)).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<Page
  title={name}
  description={`Video content, events coverage and podcasts in ${name}, NJ.`}
  crumbs={[{ href: '/where-i-work', label: 'Service Areas' }]}
>
  <h1>Video production in {name}, NJ<BrandMark /></h1>
  <p>{county.data.blurb || `Video content, events coverage, podcasts and drone work for towns, businesses and trades across ${name}.`}</p>

  <h2>Towns we serve in {name}</h2>
  {towns.length ? (
    <ul class="checks towns">
      {towns.map((t) => <li><a href={`/where-i-work/${county.id}/${t.id}`}>{t.data.name}, NJ</a></li>)}
    </ul>
  ) : null}

  <h2>Services in {name}</h2>
  <ul class="checks">
    {SERVICES.map((s) => <li><a href={`/services#${s.id}`}>{s.title}</a>: {s.short}</li>)}
  </ul>
</Page>

<style>
  .towns { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .checks a { text-decoration: underline; }
</style>
