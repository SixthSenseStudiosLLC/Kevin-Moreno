---
import { getCollection, getEntry } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { SERVICES } from '../../../site';

export async function getStaticPaths() {
  const towns = await getCollection('towns');
  return towns.map((town) => ({ params: { county: town.data.county.id, town: town.id }, props: { town } }));
}

const { town } = Astro.props;
const county = await getEntry(town.data.county);
const work = (await getCollection('work', (w) => w.data.town.id === town.id && !w.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const stories = (await getCollection('stories', (s) => s.data.town.id === town.id && !s.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const name = town.data.name;
---

<Page
  title={`${name}, NJ`}
  description={`Video content, events coverage and podcasts in ${name}, ${county.data.name}, NJ.`}
  crumbs={[
    { href: '/where-i-work', label: 'Service Areas' },
    { href: `/where-i-work/${county.id}`, label: county.data.name },
  ]}
>
  <h1>Video production in {name}, NJ</h1>
  {town.data.blurb ? <p>{town.data.blurb}</p> : <p><span class="placeholder">Town intro coming soon</span></p>}

  <h2>Why choose a local videographer in {name}?</h2>
  <ul class="checks">
    <li>I know {county.data.name}, its towns and the people who keep them running</li>
    <li>One person from first call to final cut</li>
    <li>Batched shoot days, so filming never takes over your week</li>
  </ul>

  <h2>Services in {name}</h2>
  {SERVICES.map((s) => (
    <>
      <h3>{s.title} in {name}</h3>
      <p>{s.short}</p>
      <ul class="checks">
        {s.points.map((p) => <li>{p}</li>)}
      </ul>
    </>
  ))}

  <h2>Work in {name}</h2>
  {work.length ? (
    <ul class="checks">
      {work.map((w) => <li><a href={`/work/${w.id}`}>{w.data.client}</a>: {w.data.businessType}</li>)}
    </ul>
  ) : (
    <p><span class="placeholder">Portfolio pieces coming soon</span></p>
  )}

  {stories.length > 0 && (
    <>
      <h2>Stories from {name}</h2>
      <ul class="checks">
        {stories.map((s) => <li><a href={`/stories/${s.id}`}>{s.data.title}</a></li>)}
      </ul>
    </>
  )}

  <p><a href="/contact#quote" class="btn btn-primary">Get a free quote in {name}</a></p>
</Page>

<style>
  .checks a { text-decoration: underline; }
</style>
