---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import AreaMap from '../../components/AreaMap.astro';

const counties = (await getCollection('counties')).sort((a, b) => a.data.order - b.data.order);
const towns = (await getCollection('towns')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Page title="Service Areas" description="Video production across North Jersey.">
  <h1>Service areas across North Jersey</h1>
  <p>
    I film towns, downtowns, local businesses and trade companies across North Jersey. Every story is tied to the town
    it was made in. Find yours below. Don't see it? <a href="/contact#quote">Reach out anyway.</a>
  </p>

  {counties.map((c) => {
    const list = towns.filter((t) => t.data.county.id === c.id);
    return (
      <section class="county">
        <h2><a href={`/where-i-work/${c.id}`}>{c.data.name}</a></h2>
        {list.length ? (
          <ul class="checks towns">
            {list.map((t) => <li><a href={`/where-i-work/${c.id}/${t.id}`}>{t.data.name}, NJ</a></li>)}
          </ul>
        ) : (
          <span class="placeholder">Towns coming soon</span>
        )}
      </section>
    );
  })}

  <AreaMap slot="after" />
</Page>

<style>
  .county h2 a { text-decoration: none; }
  .towns { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .towns a { text-decoration: none; }
  .towns a:hover { text-decoration: underline; }
</style>
