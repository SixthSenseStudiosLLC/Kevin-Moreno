---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const counties = (await getCollection('counties')).sort((a, b) => a.data.order - b.data.order);
const towns = await getCollection('towns');
---

<Base title="Where I Work" description="Video production across Bergen, Passaic and Sussex County, NJ.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Where I work</p>
      <h1>Bergen, Passaic<br />and Sussex County.</h1>
      <p class="lede">Every story is tied to the town it was made in.</p>
      <div class="grid grid-3 list">
        {counties.map((c) => {
          const count = towns.filter((t) => t.data.county.id === c.id).length;
          return (
            <a href={`/where-i-work/${c.id}`} class="card">
              <h3>{c.data.name}</h3>
              <p class="muted">{count ? `${count} town${count === 1 ? '' : 's'}` : 'Towns coming soon'}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  .list { margin-top: 48px; }
  .list a { text-decoration: none; }
  .list a:hover { border-color: var(--accent); }
</style>
