---
import Page from '../layouts/Page.astro';
import DiyDiagram from '../components/DiyDiagram.astro';
import { PHONE, SPOT, SAY, EXTRA, IDEAS, PLAN, EDITING, CHECKLIST } from '../data/diy';

const sections = [
  ['phone', 'Get your phone ready'],
  ['spot', 'Pick your spot'],
  ['say', 'What to say'],
  ['extra', 'Film a few extra shots'],
  ['ideas', 'Ideas to film'],
  ['plan', 'Your first 30 days'],
  ['editing', 'Put it together'],
  ['checklist', 'Quick check'],
];
---

<Page
  title="DIY Content Guide"
  description="Film your own business content with your phone, starting today. Free, simple steps from Reliable Kev Media."
  quote={false}
>
  <h1>Film your own content, right now, today.</h1>
  <p class="lede">
    Maybe you're not ready to bring in a content team. Maybe you're not sure what it would look like to have someone
    help you plan, shoot or edit. That's okay. You can start on your own, today, for free, with the phone already in
    your pocket.
  </p>
  <p class="lede">
    Everything we know about getting started is on this page, in simple steps. Nothing to buy and no experience
    needed. Take what helps you, skip what doesn't, and just begin.
  </p>

  <nav class="toc" aria-label="On this page">
    {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <section id="phone">
    <h2>Get your phone ready</h2>
    <p class="big">Just aim and press record.</p>
    <p>That's really it. If you want, three small things help:</p>
    <ul class="checks">{PHONE.map((s) => <li>{s}</li>)}</ul>
  </section>

  <section id="spot">
    <h2>Pick your spot</h2>
    <ul class="checks">{SPOT.map((s) => <li>{s}</li>)}</ul>
    <div class="diagrams">
      <DiyDiagram name="light" />
      <DiyDiagram name="setup" />
    </div>
  </section>

  <section id="say">
    <h2>What to say</h2>
    <p>Short videos work best when they follow this order. Think about it before you press record.</p>
    <ul class="steps">
      {SAY.map((s) => (
        <li>
          <strong>{s.step}</strong>
          <span>{s.text}</span>
        </li>
      ))}
    </ul>
    <DiyDiagram name="timeline" />
  </section>

  <section id="extra">
    <h2>Film a few extra shots</h2>
    <p>These are little clips you can drop into your video so it isn't just you talking the whole time.</p>
    <ul class="checks">{EXTRA.map((e) => <li>{e}</li>)}</ul>
    <DiyDiagram name="shots" />
  </section>

  <section id="ideas">
    <h2>Ideas to film</h2>
    <p>Not sure what to make? Any of these work for almost any business.</p>
    <ul class="checks ideas">{IDEAS.map((i) => <li>{i}</li>)}</ul>
  </section>

  <section id="plan">
    <h2>Your first 30 days</h2>
    <p>
      Three videos a week for four weeks. Film all three on one day, then post them across the week. Each week has one
      idea, so you always know what to make next.
    </p>
    <div class="weeks">
      {PLAN.map((w) => (
        <div class="week">
          <p class="wk">{w.week}</p>
          <h3>{w.theme}</h3>
          <ul>{w.posts.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section id="editing">
    <h2>Put it together</h2>
    <ul class="checks">{EDITING.map((e) => <li>{e}</li>)}</ul>
  </section>

  <section id="checklist">
    <h2>Quick check before you record</h2>
    <ul class="boxes">{CHECKLIST.map((c) => <li>{c}</li>)}</ul>
  </section>

  <section class="cta">
    <h2>If you ever want a hand</h2>
    <p>
      Start here, and come back anytime. If one day you'd rather have help planning, filming or editing, we'd be glad
      to talk it through with you. No pressure either way.
    </p>
    <div class="actions">
      <a href="/start" class="btn">Talk with us</a>
    </div>
  </section>
</Page>

<style>
  .lede { font-size: 1.1rem; max-width: 62ch; }
  .big { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 1.9rem); color: var(--text) !important; margin: 4px 0 14px; }
  .toc { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 8px; }
  .toc a {
    padding: 8px 12px; border: 1px solid var(--line); text-decoration: none;
    font-family: var(--font-label); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .toc a:hover { border-color: var(--text); }
  section { scroll-margin-top: 110px; margin-top: 56px; }
  section > h2 { margin-top: 0 !important; }
  .steps { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 10px; }
  .steps li { display: grid; grid-template-columns: 170px 1fr; gap: 12px; align-items: baseline; padding: 14px 0; border-top: 1px solid var(--line); }
  .steps strong { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.95rem; }
  .steps span { color: #d9d2c4; }
  .ideas { columns: 2; column-gap: 32px; }
  .ideas li { break-inside: avoid; }
  .weeks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 18px; }
  .week { background: var(--cream); color: #111; padding: 18px 20px; }
  .week .wk { font-family: var(--font-label); font-size: 0.74rem; letter-spacing: 0.18em; text-transform: uppercase; color: #777 !important; margin: 0 0 6px; }
  .week h3 { margin: 0 0 10px !important; color: #111; font-size: 1.05rem; }
  .week ul { margin: 0; padding-left: 1.1em; font-size: 0.92rem; }
  .week li { margin-bottom: 6px; }
  .boxes { list-style: none; padding: 0; margin: 18px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }
  .boxes li { display: flex; gap: 12px; align-items: center; padding: 12px 14px; border: 1px solid var(--line); }
  .boxes li::before { content: ''; width: 16px; height: 16px; border: 2px solid var(--text); flex: none; }
  .cta { border-top: 1px solid var(--line); padding-top: 40px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .diagrams { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 28px; }
  @media (max-width: 960px) { .weeks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .weeks { grid-template-columns: 1fr; }
    .ideas { columns: 1; }
    .steps li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
