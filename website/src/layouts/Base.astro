---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import BackgroundPhotos from '../components/BackgroundPhotos.astro';
import AutoplayVideos from '../components/AutoplayVideos.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** No header, menu, ticker or footer (used by the business card landing page). */
  bare?: boolean;
  /** Keep the page out of Google. */
  noindex?: boolean;
}

const { title, description = SITE.description, bare = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL('.' + Astro.url.pathname, Astro.site);
const home = new URL('./', Astro.site).href;

// Business details for Google, kept identical to the Google Business Profile.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  description: SITE.description,
  url: home,
  email: SITE.email,
  telephone: SITE.phone || undefined,
  areaServed: (await getCollection('counties')).map((c) => `${c.data.name}, NJ`),
  address: { '@type': 'PostalAddress', addressRegion: 'NJ', addressCountry: 'US' },
  sameAs: Object.values(SITE.socials).filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Monda&family=Montserrat:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body id="top">
    {!bare && <BackgroundPhotos />}
    {!bare && <Header />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
    <AutoplayVideos />
    <Reveal />
  </body>
</html>
