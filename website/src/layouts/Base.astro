---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import BrandMark from '../components/BrandMark.astro';
import AutoplayVideos from '../components/AutoplayVideos.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** No header, menu, ticker or footer (used by the business card landing page). */
  bare?: boolean;
  /** Keep the page out of Google. */
  noindex?: boolean;
  /** The homepage (on phones it can become one continuous scroll; see PhoneHome.astro). */
  home?: boolean;
}

const { title, description = SITE.description, bare = false, noindex = false, home: isHome = false } = Astro.props;
// The homepage is just the name, so a shared link (iMessage, texts, social) reads "Reliable Kev Media" (Kev's request).
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL('.' + Astro.url.pathname, Astro.site);
const home = new URL('./', Astro.site).href;

// Business details for Google, kept identical to the Google Business Profile.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  description: SITE.description,
  url: home,
  email: SITE.email,
  telephone: SITE.phone || undefined,
  areaServed: (await getCollection('counties')).map((c) => `${c.data.name}, NJ`),
  address: { '@type': 'PostalAddress', addressRegion: 'NJ', addressCountry: 'US' },
  sameAs: Object.values(SITE.socials).filter(Boolean),
};
---

<!doctype html>
<html lang="en" data-home={isHome ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/images/rk-monogram.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Monda&family=Montserrat:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-reveal');
      // Opening: the RK logo on black, then it dissolves into the page. Only on the first page of a visit (until the
      // tab is closed), never for people who ask for less motion; ?intro=1 replays it. The fade is pure CSS, so the
      // logo always clears by itself, even if a script fails.
      (function () {
        try {
          var replay = new URLSearchParams(location.search).get('intro') === '1';
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('intro-seen') && !replay) return;
          sessionStorage.setItem('intro-seen', '1');
          document.documentElement.dataset.intro = '';
        } catch (e) {}
      })();
      // Preview looks: add ?look=black to any page to try the black-and-cream look (?look=gray to go back).
      // The choice carries across pages until the browser tab is closed. Visitors see the gray look.
      (function () {
        try {
          var q = new URLSearchParams(location.search).get('look');
          if (q) sessionStorage.setItem('look', q);
          var look = sessionStorage.getItem('look');
          if (look && look !== 'gray') document.documentElement.dataset.look = look;
        } catch (e) {}
      })();
      // Phone scroll for the homepage (PhoneHome.astro). While PHONE_SCROLL_LIVE is false it only shows on a
      // phone that opened the site with ?phone=1 once (Kev's preview); ?phone=0 turns it back off.
      // Set it to true to give every phone visitor the scroll.
      (function () {
        var PHONE_SCROLL_LIVE = false;
        var on = PHONE_SCROLL_LIVE;
        try {
          var q = new URLSearchParams(location.search).get('phone');
          if (q === '1') localStorage.setItem('phone-scroll', '1');
          if (q === '0') localStorage.removeItem('phone-scroll');
          on = on || localStorage.getItem('phone-scroll') === '1';
        } catch (e) {}
        if (on && document.documentElement.hasAttribute('data-home')) document.documentElement.dataset.phoneScroll = '';
      })();
    </script>
  </head>
  <body id="top">
    {/* Opening (styles at the end of global.css). On the homepage it tells a short story: the RK letters, then Kev's
        before and after photos (black and white, dimmed) under his quote, then the page. Other pages: the RK only. */}
    <div class:list={['intro', { 'intro-story': isHome }]} aria-hidden="true">
      <BrandMark size="clamp(84px, 15vw, 120px)" />
      {isHome && (
        <>
          <div class="intro-photos">
            <img class="intro-photo p1" src="/images/intro/kev-before.jpg" alt="" loading="lazy" decoding="async" />
            <img class="intro-photo p2" src="/images/intro/kev-after.jpg" alt="" loading="lazy" decoding="async" />
          </div>
          <p class="intro-quote">&ldquo;Wanting to be heard was never the problem.&rdquo;<span>Kev</span></p>
          <p class="intro-skip-hint">Tap to skip</p>
        </>
      )}
    </div>
    {isHome && (
      <script is:inline>
        // Any tap, scroll or key skips the homepage opening.
        (function () {
          var el = document.querySelector('.intro-story');
          if (!el || !document.documentElement.hasAttribute('data-intro')) return;
          var skip = function () {
            document.documentElement.classList.add('intro-skipped');
            removeEventListener('keydown', skip);
            removeEventListener('wheel', skip);
          };
          el.addEventListener('pointerdown', skip);
          addEventListener('keydown', skip);
          addEventListener('wheel', skip, { passive: true });
        })();
      </script>
    )}
    {!bare && <Header />}
    <main>
      <slot />
    </main>
    <script is:inline>
      // Height of everything above <main> (top bar, menu, town ticker), so full-screen videos fill exactly the rest.
      (function () {
        var set = function () {
          var m = document.querySelector('main');
          if (m) document.documentElement.style.setProperty('--top-h', m.getBoundingClientRect().top + scrollY + 'px');
        };
        set();
        addEventListener('resize', set);
      })();
    </script>
    {!bare && <Footer />}
    <AutoplayVideos />
    <Reveal />
  </body>
</html>
